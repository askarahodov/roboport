          "code": {
            "enum": [
              "WEB",
              "PHONE",
              "WALK_IN",
              "QUALIFIED",
              "BOOKED",
              "LOST",
              "ASSIGNED",
              "REQUEST_RECEIVED",
              "CALLBACK_REQUIRED",
              "INFORMATION_REQUESTED",
              "DECLINED",
              "CALL_BACK",
              "CHECK_BOOKING",
              "SERVICE_REVIEW",
