          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "locationId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "afterOrderId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "workOrderId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ALL",
                "OUTSTANDING",
                "AWAITING_ACCEPTANCE",
                "AWAITING_VALUATION",
                "COMPLETE",
                "CANCELED"
              ],
              "default": "ALL"
            },
            "description": "Независимые фильтры количества; ожидание приёмки и оценки может пересекаться с отменой остатка."
          }
        ],
        "responses": {
          "200": {
            "description": "Страница разрешённых заказов",
