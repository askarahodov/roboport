          }
        }
      },
      "get": {
        "operationId": "listSupplierOrdersDev",
        "summary": "Список заказов",
        "description": "WAREHOUSE/MANAGER + READ, исторический cutoff. При отсутствии PRICE_PURCHASE цена null и purchasePriceHidden=true. UUID cursor; повторные query параметры запрещены.",
        "security": [
          {
            "localSession": []
          }
        ],
