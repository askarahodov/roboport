{
  "openapi": "3.1.0",
  "info": {
    "title": "БоксРитм — закрытый цикл закупки поставщика",
    "version": "0.1.0-dev",
    "description": "Только synthetic HTTPS loopback, ROBOport_SYNTHETIC_AUTO_API=1 и ROBOport_SYNTHETIC_AUTH_API=1; без настоящих заказов, EDI, платежей, OEM fitment или production API."
  },
  "x-synthetic-only": true,
  "servers": [
    {
      "url": "https://127.0.0.1"
    }
  ],
  "paths": {
    "/api/v1/dev/auto/organizations/{org_id}/warehouse/supplier-orders": {
      "post": {
        "operationId": "createSupplierOrderDev",
        "summary": "Создать заявку на дефицит",
        "description": "WAREHOUSE + CREATE/READ/PRICE_PURCHASE и scope; 2–5 предложений минимум двух поставщиков, один артикул, выбранная RUB котировка не истекла. Новые сравнения только RUB. Без прихода на склад.",
        "security": [
          {
            "localSession": []
          }
        ],
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
