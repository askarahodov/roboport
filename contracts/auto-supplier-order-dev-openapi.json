  "components": {
    "securitySchemes": {
      "localSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "rp_session"
      }
    },
    "schemas": {
      "Offer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offer_id",
          "supplier_id",
          "source_revision",
          "quoted_at",
          "expires_at",
          "currency",
          "unit_purchase_minor",
          "available_quantity",
          "article"
        ],
        "properties": {
          "offer_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "supplier_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "source_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "quoted_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Новые заказы — только RUB для всех предложений; другие коды допускаются только в точном повторе ранее сохранённого пакета."
          },
          "unit_purchase_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "available_quantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "article": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "delivery_days": {
            "type": "integer",
            "minimum": 0,
            "maximum": 365,
            "default": 0
          }
        }
      },
      "Order": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locationId",
          "workOrderId",
          "lotId",
          "desiredQuantity",
          "offers",
          "selectedSupplierId",
          "selectedOfferId"
        ],
        "properties": {
          "locationId": {
            "type": "string",
            "format": "uuid"
          },
          "workOrderId": {
            "type": "string",
            "format": "uuid"
          },
          "lotId": {
            "type": "string",
            "format": "uuid"
          },
          "desiredQuantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "offers": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "$ref": "#/components/schemas/Offer"
            }
          },
          "selectedSupplierId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "selectedOfferId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          }
        }
      },
      "Delivery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locationId",
          "quantity",
          "supplierReference"
        ],
        "properties": {
          "locationId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "supplierReference": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160,
            "pattern": "^\\S(?:.*\\S)$"
          }
        }
      },
      "Cancel": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locationId"
        ],
        "properties": {
          "locationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "OrderReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "orderId",
          "orderedQuantity",
          "syntheticOnly"
        ],
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "orderedQuantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "syntheticOnly": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "DeliveryReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deliveryId",
          "documentId",
          "syntheticOnly"
        ],
        "properties": {
          "deliveryId": {
            "type": "string",
            "format": "uuid"
          },
          "documentId": {
            "type": "string",
            "format": "uuid"
          },
          "syntheticOnly": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "CancelReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cancelId",
          "canceledQuantity",
          "syntheticOnly"
        ],
        "properties": {
          "cancelId": {
            "type": "string",
            "format": "uuid"
          },
          "canceledQuantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "syntheticOnly": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "OrderRow": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "orderId",
          "workOrderId",
          "lotId",
          "article",
          "orderedQuantity",
          "supplierId",
          "offerId",
          "quoteRevision",
          "purchaseUnitMinor",
          "purchasePriceHidden",
          "currency",
          "documentedQuantity",
          "acceptedQuantity",
          "valuedQuantity",
          "canceledQuantity",
          "outstandingQuantity"
        ],
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "workOrderId": {
            "type": "string",
            "format": "uuid"
          },
          "lotId": {
            "type": "string",
            "format": "uuid"
          },
          "article": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "orderedQuantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "supplierId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "offerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "quoteRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "purchaseUnitMinor": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000000000
              },
              {
                "type": "null"
              }
            ]
          },
          "purchasePriceHidden": {
            "type": "boolean"
          },
          "currency": {
            "const": "RUB",
            "type": "string"
          },
          "documentedQuantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "acceptedQuantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "valuedQuantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "canceledQuantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "outstandingQuantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "purchasePriceHidden": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "purchaseUnitMinor": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "purchaseUnitMinor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000000000
                }
              }
            }
          }
        ]
      },
      "OrderPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "syntheticOnly",
          "items",
          "nextOrderId"
        ],
        "properties": {
          "syntheticOnly": {
            "type": "boolean",
            "const": true
          },
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/OrderRow"
            }
          },
          "nextOrderId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "requestId"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "FORBIDDEN",
              "NOT_FOUND",
              "CONFLICT",
              "INVALID_INPUT"
            ]
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "PurchaseDelivery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deliveryId",
          "documentId",
          "quantity",
          "createdAt",
          "stage"
        ],
        "properties": {
          "deliveryId": {
            "type": "string",
            "format": "uuid"
          },
          "documentId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "stage": {
            "type": "string",
            "enum": [
              "DRAFT",
              "ACCEPTED",
              "VALUED"
            ]
          }
        }
      },
      "PurchaseDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "syntheticOnly",
          "order",
          "desiredQuantity",
          "availableAtOrder",
          "createdAt",
          "quotedAt",
          "expiresAt",
          "offers",
          "deliveries",
          "nextDeliveryId"
        ],
        "properties": {
          "syntheticOnly": {
            "type": "boolean",
            "const": true
          },
          "order": {
            "$ref": "#/components/schemas/OrderRow"
          },
          "desiredQuantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "availableAtOrder": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "quotedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "offers": {
            "anyOf": [
              {
                "type": "array",
                "minItems": 2,
                "maxItems": 5,
                "items": {
                  "$ref": "#/components/schemas/Offer"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "deliveries": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/PurchaseDelivery"
            }
          },
          "nextDeliveryId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "order": {
                  "properties": {
                    "purchasePriceHidden": {
                      "const": true
                    }
                  },
                  "required": [
                    "purchasePriceHidden"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "offers": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "offers": {
                  "type": "array"
                }
              }
            }
          }
        ]
      }
    }
  }
}
