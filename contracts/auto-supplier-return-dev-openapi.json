{
  "openapi": "3.1.0",
  "info": {
    "title": "БоксРитм — закрытый жизненный цикл возврата поставщику",
    "version": "0.1.0-dev",
    "description": "Только синтетический HTTPS loopback с ROBOport_SYNTHETIC_AUTO_API=1 и ROBOport_SYNTHETIC_AUTH_API=1. Не production API, не юридическая кредит-нота."
  },
  "x-synthetic-only": true,
  "servers": [
    {
      "url": "https://127.0.0.1"
    }
  ],
  "paths": {
    "/api/v1/dev/auto/organizations/{org_id}/warehouse/supplier-returns": {
      "post": {
        "operationId": "draftSupplierReturnDev",
        "summary": "Создать акт возврата",
        "description": "WAREHOUSE, SUPPLIER_ORDER READ/CREATE, оценённый принятый приход, UUID запроса, допустимое количество; черновик без проводок.",
        "security": [
          {
            "localSession": []
          }
        ],
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Draft"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Записано или точный авторизованный повтор",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftReceipt"
                }
              }
            }
          },
          "403": {
            "description": "Нет сессии, CSRF, scope, действующей роли или полномочий"
          },
          "404": {
            "description": "Dev API выключен"
          },
          "409": {
            "description": "Конфликт состояния, количества или ключа"
          },
          "422": {
            "description": "Некорректные параметры запроса"
          }
        }
      }
    },
    "/api/v1/dev/auto/organizations/{org_id}/warehouse/supplier-returns/approvals": {
      "post": {
        "operationId": "approveSupplierReturnDev",
        "summary": "Утвердить акт",
        "description": "Независимый MANAGER, READ/CLOSE, остаток и лимит исходного прихода, одно терминальное решение, физическая и стоимостная запись.",
        "security": [
          {
            "localSession": []
          }
        ],
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Approval"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Записано или точный авторизованный повтор",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalReceipt"
                }
              }
            }
          },
          "403": {
            "description": "Нет сессии, CSRF, scope, действующей роли или полномочий"
          },
          "404": {
            "description": "Dev API выключен"
          },
          "409": {
            "description": "Конфликт состояния, количества или ключа"
          },
          "422": {
            "description": "Некорректные параметры запроса"
          }
        }
      }
    },
    "/api/v1/dev/auto/organizations/{org_id}/warehouse/supplier-returns/decisions": {
      "post": {
        "operationId": "decideSupplierReturnDev",
        "summary": "Отменить или отклонить акт",
        "description": "CANCEL — автор WAREHOUSE; REJECT — другой MANAGER. READ/CLOSE и cutoff; без проводок, одно терминальное решение.",
        "security": [
          {
            "localSession": []
          }
        ],
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Decision"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Записано или точный авторизованный повтор",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionReceipt"
                }
              }
            }
