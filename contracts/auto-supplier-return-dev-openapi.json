            "maxLength": 240
          },
          "supplierReference": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          },
          "serialIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "maxItems": 50,
            "uniqueItems": true,
            "description": "Необязательный список всех идентифицированных единиц акта; при непустом списке длина равна quantity. Утверждение происхождения из указанного прихода обязательно."
