          "403": {
            "description": "Нет сессии, CSRF, scope, действующей роли или полномочий"
          },
          "404": {
            "description": "Dev API выключен"
          },
          "409": {
            "description": "Конфликт состояния, количества или ключа"
          },
          "422": {
            "description": "Некорректные параметры запроса"
          }
        }
      }
    },
    "/api/v1/dev/auto/organizations/{org_id}/warehouse/supplier-returns/pending": {
      "get": {
        "operationId": "pendingSupplierReturnsDev",
        "summary": "Очередь открытых актов",
        "description": "review — чужие акты MANAGER; own — собственные акты WAREHOUSE. READ без исторического cutoff, действующая роль и филиал; терминальные акты исключены.",
        "security": [
          {
            "localSession": []
          }
        ],
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "locationId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "afterDocumentId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "view",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "review",
                "own"
              ],
              "default": "review"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Страница очереди",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingPage"
                }
              }
            }
          },
          "403": {
            "description": "Нет доступа"
          },
          "404": {
            "description": "Dev API выключен"
          },
          "422": {
            "description": "Некорректные параметры"
          }
        }
      }
    }
  },
  "components": {
