    "/api/v1/dev/auto/customer/orders/export": {
      "get": {
        "operationId": "exportCustomerOrdersDev",
        "summary": "Скачать CSV собственных заказов по текущим фильтрам",
        "description": "Повторная авторизация и проверка связи на сервере. До 500 строк, только текущие доступные synthetic orders; без полного VIN, контактов и документов. Текстовые поля экранированы против формул.",
        "security": [
          {
            "localSession": []
          }
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Буквальный поиск по марке и модели, без VIN/контактов. Регистр не учитывается.",
            "schema": {
              "type": "string",
              "maxLength": 64,
              "default": ""
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ALL",
                "SCHEDULED",
                "CANCELED"
              ],
              "default": "ALL"
            }
          },
          {
            "name": "fromDay",
            "in": "query",
            "required": false,
            "description": "Включительная локальная дата текущей записи в IANA-зоне её филиала.",
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          {
            "name": "toDay",
            "in": "query",
            "required": false,
            "description": "Включительная локальная дата текущей записи в IANA-зоне её филиала.",
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          {
            "name": "vehicleId",
            "in": "query",
            "required": false,
            "description": "UUID выбранного автомобиля; только заказы исходного подтверждённого заказчика, не наследование истории по VIN. Чужой или отсутствующий автомобиль даёт пустой набор.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Полный CSV выбранного набора, в том числе заголовок при пустом наборе",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "X-Content-Type-Options": {
                "schema": {
                  "const": "nosniff"
                }
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Нет сессии",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Доступ запрещён",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Недоступный ресурс или выключенный dev API",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "409": {
            "description": "Более 500 совпадений: сузить фильтры; частичный CSV не возвращается",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportLimit"
                }
              }
            }
