{
  "openapi": "3.1.0",
  "info": {
    "title": "БоксРитм — история и согласование смет клиента (dev)",
    "version": "0.1.0-dev",
    "description": "Закрытый synthetic HTTPS loopback. Доступ по исходной verified customer link. Только существующие серверные операции. Не mobile auth и не production contract."
  },
  "x-synthetic-only": true,
  "x-release-blocked-by": [
    "#119",
    "#117"
  ],
  "servers": [
    {
      "url": "https://127.0.0.1"
    }
  ],
  "paths": {
    "/api/v1/dev/auto/customer/orders": {
      "get": {
        "operationId": "listCustomerOrdersDev",
        "security": [
          {
            "localSession": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "default": 20
            },
            "required": false
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,256}$"
            },
            "required": false
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Буквальный поиск по марке и модели, без VIN/контактов. Регистр не учитывается.",
            "schema": {
              "type": "string",
              "maxLength": 64,
              "default": ""
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ALL",
                "SCHEDULED",
                "CANCELED"
              ],
              "default": "ALL"
            }
          },
          {
            "name": "fromDay",
            "in": "query",
            "required": false,
            "description": "Включительная локальная дата текущей записи в IANA-зоне её филиала.",
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          {
            "name": "toDay",
            "in": "query",
            "required": false,
            "description": "Включительная локальная дата текущей записи в IANA-зоне её филиала.",
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          {
            "name": "vehicleId",
            "in": "query",
            "required": false,
            "description": "UUID выбранного автомобиля; только заказы исходного подтверждённого заказчика, не наследование истории по VIN. Чужой или отсутствующий автомобиль даёт пустой набор.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Заказы исходного клиента",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "401": {
            "description": "Нет сессии",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Доступ запрещён",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Недоступный ресурс или выключенный dev API",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "422": {
            "description": "Некорректный запрос",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Только исходный подтверждённый заказчик; фильтры применяются на сервере до LIMIT. Курсор подписан для сессии и точного нормализованного набора фильтров; при смене фильтров начать с первой страницы."
      }
    },
