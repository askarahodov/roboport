  "components": {
    "securitySchemes": {
      "localSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "rp_session"
      }
    },
    "schemas": {
      "Vehicle": {
        "type": "object",
        "properties": {
          "make": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "modelYear": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1886,
                "maximum": 2100
              },
              {
                "type": "null"
              }
            ]
          },
          "vinLast4": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-HJ-NPR-Z0-9]{4}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "make",
          "model",
          "modelYear",
          "vinLast4"
        ],
        "additionalProperties": false
      },
      "Appointment": {
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "SCHEDULED",
              "CANCELED"
            ]
          }
        },
        "required": [
          "startsAt",
          "endsAt",
          "status"
        ],
        "additionalProperties": false
      },
      "Card": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "locationId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "vehicle": {
            "$ref": "#/components/schemas/Vehicle"
          },
          "appointment": {
            "$ref": "#/components/schemas/Appointment"
          }
        },
        "required": [
          "id",
          "organizationId",
          "locationId",
          "createdAt",
          "vehicle",
          "appointment"
        ],
        "additionalProperties": false
      },
      "Page": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Card"
            },
            "maxItems": 30,
            "minItems": 0
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,256}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "syntheticOnly": {
            "const": true,
            "type": "boolean"
          },
          "releaseAllowed": {
            "const": false,
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "nextCursor",
          "syntheticOnly",
          "releaseAllowed"
        ],
        "additionalProperties": false
      },
      "QuoteLine": {
        "oneOf": [
          {
            "type": "object",
