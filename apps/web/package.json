{
  "name": "roboport-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run generate:api:auto-dev && vite",
    "typecheck": "npm run generate:api:auto-dev && tsc --noEmit",
    "build": "npm run generate:api:auto-dev && tsc --noEmit && vite build",
    "generate:api": "openapi-typescript ../../contracts/openapi.yaml -o src/shared/api/schema.d.ts",
    "test:e2e": "playwright test",
    "test:docs:e2e": "playwright test --config playwright.docs.config.ts",
    "generate:api:auto-dev": "openapi-typescript ../../contracts/auto-dev-openapi.yaml -o src/shared/api/autoDevSchema.d.ts"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.4"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "openapi-typescript": "7.10.1",
    "@playwright/test": "1.56.1"
  }
}
