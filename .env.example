ROBO_ENV=development
ROBO_ENABLE_REAL_REQUESTS=false
ROBO_PUBLIC_BASE_URL=http://localhost:5173
ROBO_API_BASE_URL=http://127.0.0.1:8000
# Credentials and long random session signing values MUST be supplied in ignored local env.
# ROBO_DATABASE_URL=postgresql+psycopg://<user>:<password>@127.0.0.1:5432/roboport_test
# ROBO_AUTH_COOKIE_NAME=rp_session
# ROBO_AUTH_COOKIE_SECURE=true  # requires HTTPS; loopback-only local dev exception documented
# ROBO_MINIO_ENDPOINT=http://127.0.0.1:9000
# ROBO_MINIO_BUCKET=roboport-documents-dev
# ROBO_MINIO_QUARANTINE_BUCKET=roboport-quarantine-dev
# ROBO_MINIO_ACCESS_KEY=  # never a real key in Git
# ROBO_MINIO_SECRET_KEY=  # never a real key in Git
